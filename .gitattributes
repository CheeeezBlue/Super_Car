# 统一换行符，避免 Windows / Linux 混合提交时产生整文件 diff
* text=auto

# 源码统一 LF
*.c          text eol=lf
*.h          text eol=lf
*.cpp        text eol=lf
*.s          text eol=lf
*.md         text eol=lf
*.ioc        text eol=lf
*.gitignore  text eol=lf
.gitattributes text eol=lf

# Keil 工程文件保持 CRLF（Windows 工具链原生格式）
*.uvprojx    text eol=crlf
*.uvoptx     text eol=crlf

# 二进制文件不做换行转换
*.hex        binary
*.bin        binary
*.axf        binary
*.o          binary
*.lib        binary
*.a          binary
